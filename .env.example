# Plantilla de variables de entorno.
# Copiar este archivo como .env y completar los valores:
#
#   cp .env.example .env
#
# El .env real está en .gitignore y nunca debe subirse al repositorio.
# Este archivo, en cambio, sí se versiona: documenta qué variables hacen
# falta sin exponer ningún secreto.

# ─────────────────────────────────────────────────────────────────────
# OBLIGATORIA
# ─────────────────────────────────────────────────────────────────────

# Personal Access Token (classic) de GitHub.
#
# Generarlo en:
#   Settings → Developer settings → Personal access tokens → Tokens (classic)
#
# Scopes necesarios:
#   repo        control de repositorios (crear repos, issues y commits)
#   user        datos del usuario autenticado
#   admin:org   solo si se opera sobre organizaciones
#
# Los tokens tienen fecha de vencimiento. Si expira, el servidor arranca
# normalmente y todas las tools fallan con AUTH_ERROR (HTTP 401).
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# OPCIONALES
# ─────────────────────────────────────────────────────────────────────

# Nivel mínimo de log que se escribe a stderr: debug | info | warn | error
# Por defecto: info
LOG_LEVEL=info
